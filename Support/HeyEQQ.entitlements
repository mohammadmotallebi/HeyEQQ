<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime blocks audio input unless this is granted. Core Audio process taps
         deliver captured audio as an input stream, so keep it for release (notarized) builds. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
